# Copy to .env and fill in. Never commit the real .env.

ENV=dev

# Razorpay (TEST MODE ONLY — key must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM — tried in this order by app/agents/llm.py: Anthropic, then Groq, then local Ollama.
# Anthropic (primary)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (fast hosted fallback — used when ANTHROPIC_API_KEY is unset). Available models vary by
# account; check https://api.groq.com/openai/v1/models with your key if this one 404s.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local Ollama (last-resort, fully-offline fallback — used when neither key above is set)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# Optional — Voyage AI embeddings for catalog search. Leave blank to fall back to a local
# Ollama nomic-embed-text model (see app/integrations/vector_store.py).
VOYAGE_API_KEY=

# Datastores
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/razorpay_buildathon
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Merchant console auth (demo-grade shared key)
MERCHANT_API_KEY=demo-merchant-key

# Failure-mode simulation (see docs/failure_modes.md), leave unset for normal operation
SIMULATE_RAZORPAY_TIMEOUT=

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000
